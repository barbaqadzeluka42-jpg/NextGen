# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) – safe for the browser, protected by RLS.
# (Legacy projects: the "anon" key can be used instead via NEXT_PUBLIC_SUPABASE_ANON_KEY.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) – SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit.
# (Legacy projects: the "service_role" key can be used instead via SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=

# ── Site ──────────────────────────────────────────────────────────
# Public base URL (used in e-mail links and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown in the footer / privacy page when set
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Transactional e-mail (Resend) – SERVER ONLY ───────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "NEXTGEN <noreply@yourdomain.ge>"
EMAIL_FROM=
# Free Resend plan = 100 mails/day; stay below it
EMAIL_DAILY_LIMIT=90

# ── Cron (Vercel sets Authorization: Bearer $CRON_SECRET automatically) ──
CRON_SECRET=
